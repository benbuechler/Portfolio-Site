---
// Markdown projects share a reading column, photos, and an optional 3D model.
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "./BaseLayout.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import ProjectModelViewer from "../components/ProjectModelViewer.astro";
import Comments from "../components/Comments.astro";
import type { ProjectFrontmatter } from "../lib/projects";
import { getProjectImages } from "../lib/projects";

interface Props {
  frontmatter: ProjectFrontmatter;
}

const { title, summary, date, tools = [], model, comments = true, commentId } = Astro.props.frontmatter;
const images = getProjectImages(Astro.props.frontmatter);
// Keep unpublished models out of the HTML, avoiding requests for missing files.
// This check runs in development and at build time; public/ is the asset root.
if (model && (
  typeof model.src !== "string" || !/^\/models\/.+\.(glb|gltf)$/i.test(model.src) ||
  model.src.split("/").includes("..") || typeof model.alt !== "string" || !model.alt.trim()
)) {
  throw new Error(`Project "${title}" needs model.src under /models/ ending in .glb or .gltf, and descriptive model.alt text.`);
}
const hasModel = !!model && existsSync(resolve("public", `.${model.src}`));
const hasMedia = images.length > 0 || hasModel;
// Include Astro's base path so links and public images also work in a subfolder.
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const projectsHref = `${basePath}/projects`;
// Social networks need a raster image; SVG covers use the shared preview card.
const shareImage = images.find(({ src }) => /\.(png|jpe?g|webp)$/i.test(src));
---

<BaseLayout title={title} description={summary} image={shareImage?.src} imageAlt={shareImage?.alt}>
  <article class="project-article">
    <div class:list={["project-layout", { "has-media": hasMedia }]}>
      <header class="project-heading">
        <a class="back-link text-link" href={projectsHref} data-analytics-event="return-click" data-analytics-location="project-top"><span aria-hidden="true">←</span> Back to projects</a>
        <p class="eyebrow">Project</p>
        <h1>{title}</h1>
        {date && <p class="project-date">{date}</p>}
        <p class="project-summary">{summary}</p>
        {tools.length > 0 && (
          <section class="project-tools" aria-label="Tools and technologies">
            <h2>Tools</h2>
            <ul class="tag-list">
              {tools.map((tool) => <li>{tool}</li>)}
            </ul>
          </section>
        )}
        {hasMedia && (
          <nav class="project-jumps" aria-label="Project sections">
            <a href="#project-story">Read the story <span aria-hidden="true">↓</span></a>
            {hasModel && <a href="#project-model">Explore in 3D</a>}
            {images.length > 0 && <a href="#project-photos">View photos</a>}
          </nav>
        )}
      </header>

      {hasMedia && (
        <aside class="project-media" aria-label={`${title} media`}>
          {hasModel && model && (
            <div id="project-model" class="project-media-section" tabindex="-1">
              <ProjectModelViewer {...model} />
            </div>
          )}
          {images.length > 0 && (
            <div id="project-photos" class="project-media-section" tabindex="-1">
              <ProjectGallery images={images} layout="compact" />
            </div>
          )}
        </aside>
      )}

      <div id="project-story" class="project-reading" tabindex="-1">
        <div class="project-body" data-analytics-location="project-content">
          <!-- Let the story fill the page's responsive content area.
               Markdown sections start with ##. -->
          <slot />
        </div>

        <Comments title={title} enabled={comments} commentId={commentId} />

        <footer class="project-footer">
          <a class="text-link" href={projectsHref} data-analytics-event="return-click" data-analytics-location="project-bottom"><span aria-hidden="true">←</span> All projects</a>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-article {
    width: 100%;
    min-width: 0;
    margin-block: clamp(1.5rem, 4vw, 3rem) clamp(3rem, 7vw, 6rem);
    overflow-wrap: anywhere;
  }

  .back-link {
    min-height: 44px;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .project-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .project-media {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    min-width: 0;
  }

  .project-heading,
  .project-reading {
    width: 100%;
    min-width: 0;
  }

  .project-reading :global(.article-comments) {
    max-width: none;
  }

  .project-reading,
  .project-media-section {
    scroll-margin-top: 1.5rem;
  }

  .project-media-section {
    min-width: 0;
  }

  .project-jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .project-jumps a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .project-jumps a:hover {
    border-color: var(--color-accent);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.75rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .project-date {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .project-summary {
    margin-block: 1.5rem;
    color: var(--color-muted);
    font-size: 1.125rem;
  }

  .project-tools h2 {
    margin: 0 0 0.75rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tag-list {
    margin: 0;
  }

  .project-body {
    padding-bottom: 2rem;
    font-size: 1rem;
    line-height: 1.8;
  }

  /* Markdown is rendered outside this component's CSS scope. :global reaches
     that generated HTML while .project-body limits the rules to this article. */
  .project-body :global(h2),
  .project-body :global(h3) {
    margin-block: 2rem 0.75rem;
    color: var(--color-text);
    line-height: 1.3;
    scroll-margin-top: 2rem;
  }

  .project-body :global(h2) {
    font-size: 1.5rem;
  }

  .project-body :global(> :first-child) {
    margin-top: 0;
  }

  .project-body :global(h3) {
    font-size: 1.25rem;
  }

  .project-body :global(p),
  .project-body :global(ul),
  .project-body :global(ol) {
    margin-block: 1rem;
    color: var(--color-muted);
  }

  .project-body :global(ul),
  .project-body :global(ol) {
    padding-inline-start: 1.5rem;
  }

  .project-body :global(li) {
    margin-block: 0.35rem;
  }

  .project-body :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .project-body :global(blockquote) {
    margin: 1.5rem 0;
    padding-inline-start: 1.25rem;
    border-inline-start: 3px solid var(--color-accent);
    font-style: italic;
  }

  .project-body :global(code) {
    padding: 0.15em 0.35em;
    border-radius: 4px;
    background: var(--color-surface);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.875em;
  }

  .project-body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-surface);
    line-height: 1.6;
  }

  .project-body :global(pre code) {
    padding: 0;
    background: transparent;
  }

  .project-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--border-radius);
  }

  .project-body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    margin-block: 1.5rem;
    border-collapse: collapse;
  }

  .project-body :global(th),
  .project-body :global(td) {
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border);
    text-align: start;
  }

  .project-body :global(hr) {
    margin-block: 2rem;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  .project-footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 961px) {
    /* A bounded sidebar leaves most of the screen for text. Floats let the
       story use the full page width once it passes the compact media widgets. */
    .project-layout.has-media {
      --media-width: clamp(18.5rem, 28.5vw, 25rem);
      --media-gap: clamp(1.75rem, 4vw, 3.5rem);
      display: flow-root;
    }

    .has-media .project-heading {
      float: left;
      width: calc(100% - var(--media-width) - var(--media-gap));
      margin-bottom: 2.5rem;
    }

    .has-media .project-media {
      float: right;
      width: var(--media-width);
      margin: 0 0 1.5rem var(--media-gap);
    }

    .has-media .project-reading {
      clear: left;
      width: auto;
    }

    .project-reading :global(.article-comments),
    .project-footer {
      clear: both;
    }
  }

  @media (max-width: 640px) {
    .project-summary {
      font-size: 1rem;
    }

    .project-jumps {
      gap: 0.5rem;
    }

    .project-jumps a {
      padding-inline: 0.875rem;
    }
  }
</style>
