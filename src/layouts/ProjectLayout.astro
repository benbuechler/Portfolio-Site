---
// Markdown projects share a reading column and an optional photo gallery.
import BaseLayout from "./BaseLayout.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import type { ProjectFrontmatter } from "../lib/projects";
import { getProjectImages } from "../lib/projects";

interface Props {
  frontmatter: ProjectFrontmatter;
}

const { title, summary, date, tools = [] } = Astro.props.frontmatter;
const images = getProjectImages(Astro.props.frontmatter);
// Include Astro's base path so links and public images also work in a subfolder.
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const projectsHref = `${basePath}/projects`;
---

<BaseLayout title={title} description={summary}>
  <article class="project-article">
    <a class="back-link text-link" href={projectsHref}><span aria-hidden="true">←</span> Back to projects</a>

    <div class:list={["project-layout", { "has-gallery": images.length > 0 }]}>
      <header class="project-heading">
        <p class="eyebrow">Project</p>
        <h1>{title}</h1>
        {date && <p class="project-date">{date}</p>}
        <!-- <p class="project-summary">{summary}</p> -->
         <h3>Tools</h3>
        {tools.length > 0 && (
          <ul class="tag-list" aria-label="Tools and technologies">
            {tools.map((tool) => <li>{tool}</li>)}
          </ul>
        )}
      </header>

      {images.length > 0 && (
        <aside class="project-media" aria-label={`${title} photos`}>
          <ProjectGallery images={images} />
        </aside>
      )}

      <div class="project-body">
        <!-- The Markdown body becomes HTML here. Start its sections with ##;
             the project title above already supplies this page's h1. -->
        <slot />
        
      </div>

      <footer class="project-footer">
        <a class="text-link" href={projectsHref}><span aria-hidden="true">←</span> All projects</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .project-article {
    max-width: 75rem;
    min-width: 0;
    margin-block: 2rem 5rem;
    overflow-wrap: anywhere;
  }

  .back-link {
    margin-bottom: 2rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .project-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  .project-media {
    min-width: 0;
  }

  .project-heading,
  .project-body,
  .project-footer {
    max-width: 75ch;
    min-width: 0;
    grid-column: 1;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .project-date {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .project-summary {
    margin-block: 1.5rem;
    color: var(--color-muted);
    font-size: 1.125rem;
  }

  .tag-list {
    margin-block: 1.5rem 0;
  }

  .project-body {
    padding-bottom: 2rem;
    line-height: 1.8;
  }

  /* Markdown is rendered outside this component's CSS scope. :global reaches
     that generated HTML while .project-body limits the rules to this article. */
  .project-body :global(h2),
  .project-body :global(h3) {
    margin-block: 2rem 0.75rem;
    color: var(--color-text);
    line-height: 1.3;
    scroll-margin-top: 2rem;
  }

  .project-body :global(h2) {
    font-size: 1.5rem;
  }

  .project-body :global(h3) {
    font-size: 1.25rem;
  }

  .project-body :global(p),
  .project-body :global(ul),
  .project-body :global(ol) {
    margin-block: 1rem;
    color: var(--color-muted);
  }

  .project-body :global(ul),
  .project-body :global(ol) {
    padding-inline-start: 1.5rem;
  }

  .project-body :global(li) {
    margin-block: 0.35rem;
  }

  .project-body :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .project-body :global(blockquote) {
    margin: 1.5rem 0;
    padding-inline-start: 1.25rem;
    border-inline-start: 3px solid var(--color-accent);
    font-style: italic;
  }

  .project-body :global(code) {
    padding: 0.15em 0.35em;
    border-radius: 4px;
    background: var(--color-surface);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.875em;
  }

  .project-body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-surface);
    line-height: 1.6;
  }

  .project-body :global(pre code) {
    padding: 0;
    background: transparent;
  }

  .project-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--border-radius);
  }

  .project-body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    margin-block: 1.5rem;
    border-collapse: collapse;
  }

  .project-body :global(th),
  .project-body :global(td) {
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border);
    text-align: start;
  }

  .project-body :global(hr) {
    margin-block: 2rem;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  .project-footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 961px) {
    /* Floats let individual lines use the space below the gallery. flow-root
       contains the floats so tall galleries stay inside the article. */
    .project-layout.has-gallery {
      --gallery-gap: clamp(2rem, 5vw, 4rem);
      display: flow-root;
    }

    /* Keep the heading and gallery aligned without changing reading order. */
    .has-gallery .project-heading {
      float: left;
      width: calc((100% - var(--gallery-gap)) * 7 / 12);
    }

    .project-media {
      float: right;
      width: calc((100% - var(--gallery-gap)) * 5 / 12);
      margin: 0 0 1.5rem var(--gallery-gap);
    }

    /* Keep this a normal block so its lines can wrap around the gallery. */
    .has-gallery .project-body {
      clear: left;
      max-width: none;
      /* Preserve the first section's margin after clearing the heading. */
      padding-top: 1px;
    }

    .has-gallery .project-footer {
      clear: both;
      max-width: none;
    }
  }

  /* Stack photos directly after the heading, before the story, on phones and
     tablets. With no photos, no sidebar or empty image space is rendered. */
  @media (max-width: 960px) {
    .project-media {
      margin-block: 1.5rem 0;
    }
  }
</style>
