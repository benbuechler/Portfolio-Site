---
// Frontmatter runs as Astro renders the page. This layout reuses BaseLayout's
// document/navigation and adds the structure shared by the Markdown stories.
import BaseLayout from "./BaseLayout.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import { getGalleryImages } from "../lib/gallery";
// import type is only for TypeScript checks; it adds no runtime JavaScript.
import type { ExperienceFrontmatter } from "../lib/experiences";

// Markdown pages using this layout supply their YAML metadata as frontmatter.
interface Props {
  frontmatter: ExperienceFrontmatter;
}

// Destructuring gives convenient local names to the metadata fields.
const { title, summary, category, period, organization, hasStory = true } = Astro.props.frontmatter;
const images = getGalleryImages(Astro.props.frontmatter, `Experience "${title}"`);
// A template string combines Astro's configured base path with this route.
// With this project's root base, BASE_URL is "/", giving "/experience".
const experienceHref = `${import.meta.env.BASE_URL}experience`;
---

<!-- Pass story-specific metadata to the outer layout as props. Curly braces
     evaluate JavaScript expressions instead of using literal attribute text. -->
<BaseLayout title={title} description={summary} noindex={!hasStory}>
  <!-- article marks a self-contained story, with its own heading and footer. -->
  <article class="experience-article">
    <!-- The arrow is decorative; screen readers already get the link's wording. -->
    <a class="back-link text-link" href={experienceHref} data-analytics-event="return-click" data-analytics-location="experience-top"><span aria-hidden="true">←</span> Back to experience</a>

    <div class:list={["experience-layout", { "has-gallery": images.length > 0 }]}>
      <header class="experience-heading">
        <!-- Small metadata precedes the main h1. span groups inline text so it
             can be styled or hidden from assistive technology separately. -->
        <p class="eyebrow">{category} <span aria-hidden="true">/</span> {period}</p>
        <h1>{title}<span class="accent">.</span></h1>
        <!-- && conditionally renders this paragraph when organization is truthy
             (a nonempty string here); absent/empty metadata produces no paragraph. -->
        {organization && <p class="organization">{organization}</p>}
        <p class="experience-overview">{summary}</p>
      </header>

      {images.length > 0 && (
        <aside class="experience-media" aria-label={`${title} photos`}>
          <ProjectGallery images={images} subject="" />
        </aside>
      )}

      <div class="experience-story" data-analytics-location="experience-content">
        <!-- Astro inserts the Markdown body, converted into HTML, into this slot. -->
        <slot />
      </div>

      <!-- Repeat the return link so a reader reaching the bottom can navigate back. -->
      <footer class="experience-footer">
        <a class="text-link" href={experienceHref} data-analytics-event="return-click" data-analytics-location="experience-bottom"><span aria-hidden="true">←</span> Return to the timeline</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  /* These styles are scoped to this layout unless :global(...) is used below.
     ch measures roughly the width of a "0" in the current font; limiting line
     length makes long prose easier to read. rem uses the root font size.
     margin-block sets the logical top/bottom space in this writing direction. */
  .experience-article {
    max-width: 75rem;
    min-width: 0;
    margin-block: 2rem 5rem;
    overflow-wrap: anywhere;
  }

  .experience-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  .experience-media {
    min-width: 0;
  }

  .experience-heading,
  .experience-story,
  .experience-footer {
    max-width: 75ch;
    min-width: 0;
    grid-column: 1;
  }

  /* The return link is smaller and quieter than the main heading. */
  .back-link {
    margin-bottom: 2rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  /* Padding creates inner space before the thin divider. Theme variables keep
     the divider consistent with other borders in the active colour scheme. */
  .experience-heading {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  /* clamp(minimum, preferred, maximum) scales text with viewport width (vw)
     while bounding its size. Unitless line-height scales with the font; em
     spacing is relative to this heading's font size. anywhere lets an unusually
     long title break rather than force the page wider than the screen. */
  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  /* A reusable accent colour highlights just the heading's final punctuation. */
  .accent {
    color: var(--color-accent);
  }

  /* Two margin-block values mean top then bottom; a heavier font distinguishes
     the organization from the surrounding summary text. */
  .organization {
    margin-block: 1rem 0;
    font-weight: 600;
  }

  /* A slightly larger, muted summary introduces the story. */
  .experience-overview {
    margin-block: 1.5rem 0;
    color: var(--color-muted);
    font-size: 1.125rem;
  }

  /* padding-block adds internal space above and below the slotted story. */
  .experience-story {
    padding-block: 1rem 2rem;
  }

  /* Slotted Markdown generates its own HTML, outside this file's normal style
     scope. :global(h2) reaches those headings, but the parent class still limits
     the rule to this story. scroll-margin-top leaves room when jumping to one. */
  .experience-story :global(h2) {
    margin-block: 2rem 0.75rem;
    font-size: 1.375rem;
    line-height: 1.35;
    scroll-margin-top: 2rem;
  }

  /* A comma applies the same rule to both paragraph and list-item selectors.
     A generous line-height gives blocks of prose room between their lines. */
  .experience-story :global(p),
  .experience-story :global(li) {
    color: var(--color-muted);
    line-height: 1.8;
  }

  /* Underlines make inline story links recognizable without relying on colour;
     text-underline-offset separates the underline from the characters. */
  .experience-story :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  /* A top divider separates the closing navigation from the article text. */
  .experience-footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 961px) {
    /* Match project stories: photos sit to the right and text can use the space
       below the gallery. flow-root contains the floated heading and gallery. */
    .experience-layout.has-gallery {
      --gallery-gap: clamp(2rem, 5vw, 4rem);
      display: flow-root;
    }

    .has-gallery .experience-heading {
      float: left;
      width: calc((100% - var(--gallery-gap)) * 7 / 12);
    }

    .experience-media {
      float: right;
      width: calc((100% - var(--gallery-gap)) * 5 / 12);
      margin: 0 0 1.5rem var(--gallery-gap);
    }

    .has-gallery .experience-story {
      clear: left;
      max-width: none;
    }

    .has-gallery .experience-footer {
      clear: both;
      max-width: none;
    }
  }

  @media (max-width: 960px) {
    .experience-media {
      margin-block: 1.5rem 0;
    }
  }
</style>
