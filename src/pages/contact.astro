---
// This file produces /contact. Astro evaluates this frontmatter at build time;
// the visitor receives the resulting HTML rather than this data-processing code.
import BaseLayout from "../layouts/BaseLayout.astro";
// Reuse one SVG component; its name prop selects the matching platform logo.
import SocialIcon from "../components/SocialIcon.astro";

// Add your profile URLs here. Cards become links once a URL is provided.
// This array contains objects: each { } groups related key: value properties.
// TypeScript infers their string types from the values, without an interface.
// Use a full profile URL, or "mailto:you@example.com" for the email href.
const profiles = [
  { name: "LinkedIn", description: "Professional experience, education, and connections.", href: "https://www.linkedin.com/in/ben-buechler/" },
  { name: "GitHub", description: "Source code, experiments, and project repositories.", href: "https://github.com/benbuechler" },
  { name: "Email", description: "Get in touch about opportunities and collaboration.", href: "mailto:bbuechle@uwo.ca" },
  { name: "YouTube", description: "See my projects and experiences in action. ", href: "https://www.youtube.com/@realbengineering" },

];
---

<!-- BaseLayout renders this content inside its slot and uses these props for
     the browser-tab title and search-engine description. -->
<BaseLayout title="Contact" description="Connect with Ben Buechler through professional profiles and email.">
  <!-- header introduces this page; h1 gives it a single primary heading. -->
  <header class="page-heading">
    <p class="eyebrow">Contact</p>
    <h1>Let’s connect<span class="accent">!</span></h1>
    <p class="page-intro">
      Find my work online or get in touch about electrical engineering,
      projects, and opportunities to collaborate.
    </p>
  </header>

  <!-- aria-label gives the section a descriptive accessible name. The shared
       card-grid class in global.css handles responsive rows and columns. -->
  <section class="card-grid" aria-label="Professional profiles and contact information">
    <!-- map returns a card for each object. Destructuring ({ ... }) extracts
         its fields, and the arrow function implicitly returns the (...) markup. -->
    {profiles.map(({ name, description, href }) => (
      <article class="content-card">
        {/* The logo is decorative because the adjacent heading names the card.
            Keeping both in a row makes each platform easy to recognise. */}
        <div class="contact-card-heading">
          <span class="profile-icon"><SocialIcon name={name} /></span>
          <h2>{name}</h2>
        </div>
        <p>{description}</p>
        {/* A ternary chooses one branch: a non-empty href creates a link,
            while an empty string is falsy and selects the status paragraph. */}
        {href ? (
          <a class="text-link" href={href} target="_blank" rel="noopener noreferrer" data-analytics-event="contact-click" data-analytics-location="contact-profiles" data-analytics-label={name}>
            {name === "Email" ? "Send an email" : `Visit ${name}`} <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <p class="status">{name === "Email" ? "Email address coming soon" : "Profile link coming soon"}</p>
        )}
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  /* Scoped to this page. var() reads the colour set in global.css, so this
     accent follows whichever theme BaseLayout selects. */
  .accent {
    color: var(--color-accent);
  }

  /* Flexbox keeps each logo and its heading aligned in one row. The gap adds
     space between them, while margin separates the row from the description. */
  .contact-card-heading {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  /* The heading's default margins would push it out of line with the logo. */
  .contact-card-heading h2 {
    margin: 0;
  }

  /* A fixed-size tile gives each different-shaped logo the same visual space.
     Grid centres the SVG; flex-shrink: 0 keeps its size on narrow screens.
     currentColor inside the SVG inherits this theme-aware text colour. */
  .profile-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-bg);
    color: var(--color-accent);
  }
</style>
