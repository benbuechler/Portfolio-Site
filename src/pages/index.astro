
---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PageCloud from "../components/PageCloud.astro";
import { sitePages } from "../lib/site-pages";
---

<BaseLayout title="Home">
  <div class="home-hero">
    <PageCloud pages={sitePages} />
    <div class="hero-content">
      <Header />
    </div>
  </div>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(32rem, 75svh, 54rem);
    padding-block: clamp(2rem, 5vw, 5rem) clamp(3rem, 7vw, 6rem);
  }

  .hero-content {
    width: 100%;
    max-width: 48rem;
  }
</style>
