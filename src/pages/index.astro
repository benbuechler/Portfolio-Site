
---
const projects = [
  {
    title: "Wireless Load-Sensing Bolt",
    category: "Electronics / Embedded Systems",
    description: "Exploring NFC-powered wireless strain sensing for industrial fasteners."
  },
  {
    title: "Home Lab & Automation",
    category: "Networking / Software",
    description: "Building and managing self-hosted services, servers, and automation systems."
  },
  {
    title: "Microcontroller Projects",
    category: "Embedded Programming",
    description: "Developing hardware and firmware using PIC, ESP32, and other microcontrollers."
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Engineering projects and portfolio of Ben Buechler." />
    <title>Ben Buechler | Engineering Portfolio</title>
  </head>
  <body>
    <nav>
      <a class="logo" href="/">BB<span>.</span></a>
      <a href="#projects">Projects</a>
    </nav>

    <main>
      <section class="hero">
        <p class="eyebrow">ENGINEERING · TECHNOLOGY · DESIGN</p>
        <h1>Hi, I'm Ben.<br /><span>I build things.</span></h1>
        <p class="intro">
          Exploring the intersection of electronics, software,
          automation, and creative engineering.
        </p>
        <a class="button" href="#projects">Explore my work ↓</a>
      </section>

      <section id="projects">
        <p class="eyebrow">SELECTED WORK</p>
        <h2>Featured Projects</h2>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <p class="category">{project.category}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer>© {new Date().getFullYear()} Ben Buechler</footer>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: #090d17;
    color: #f4f6fa;
    font-family: Inter, system-ui, sans-serif;
    line-height: 1.6;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 7%;
  }

  a { color: inherit; text-decoration: none; }

  .logo { font-size: 26px; font-weight: 800; }
  .logo span, .hero h1 span { color: #6d91ff; }

  main { max-width: 1200px; margin: auto; padding: 0 7%; }

  .hero {
    min-height: 75vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow {
    color: #8eabff;
    letter-spacing: 3px;
    font-size: 12px;
    font-weight: 700;
  }

  h1 {
    font-size: clamp(48px, 8vw, 100px);
    line-height: 1.08;
    letter-spacing: -3px;
    margin: 20px 0;
  }

  .intro {
    color: #a9b1c2;
    font-size: 19px;
    max-width: 550px;
  }

  .button {
    margin-top: 30px;
    padding: 14px 24px;
    background: #5076f2;
    width: fit-content;
    border-radius: 8px;
    font-weight: 600;
  }

  #projects { padding: 60px 0 120px; }
  h2 { font-size: 38px; }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .project-card {
    background: #131a2b;
    border: 1px solid #263249;
    border-radius: 14px;
    padding: 28px;
    transition: transform 0.25s, border-color 0.25s;
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: #6d91ff;
  }

  .category { color: #8eabff; font-size: 12px; }
  .project-card h3 { font-size: 22px; }
  .project-card p:last-child { color: #a9b1c2; }

  footer {
    padding: 30px 7%;
    border-top: 1px solid #263249;
    color: #a9b1c2;
  }
</style>
