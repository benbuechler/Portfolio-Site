---
// Each project Markdown file supplies both a card here and its own page.
import BaseLayout from "../layouts/BaseLayout.astro";
import type { MarkdownInstance } from "astro";
import type { ProjectFrontmatter, ProjectPreview } from "../lib/projects";

// Exclude underscore-prefixed templates/drafts from discovery and page routes.
const projectFiles = import.meta.glob<MarkdownInstance<ProjectFrontmatter>>(
  ["/src/pages/projects/*.md", "!/src/pages/projects/_*.md"],
  { eager: true },
);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

const projects: ProjectPreview[] = Object.entries(projectFiles)
  .flatMap(([file, project]) => {
    const filename = file.split("/").at(-1) ?? "";
    if (!project.url || /^[_.]/.test(filename) || /[\[\]]/.test(filename)) return [];

    const { title, summary, image, imageAlt, tools = [], sortOrder = 0 } = project.frontmatter;
    // Give a useful build error when a new project is missing its card details.
    for (const [field, value] of Object.entries({ title, summary, image, imageAlt })) {
      if (typeof value !== "string" || !value.trim()) {
        throw new Error(`Project "${filename}" needs a non-empty ${field}.`);
      }
    }
    if (!/^\/(?!\/)/.test(image)) {
      throw new Error(`Project "${filename}" needs an image path starting with /, such as /images/projects/my-project.jpg.`);
    }
    if (!Array.isArray(tools) || tools.some((tool) => typeof tool !== "string" || !tool.trim())) {
      throw new Error(`Project "${filename}" needs tools to be an array of non-empty strings.`);
    }
    if (typeof sortOrder !== "number" || !Number.isFinite(sortOrder)) {
      throw new Error(`Project "${filename}" needs a numeric sortOrder.`);
    }
    return [{ title, summary, image, imageAlt, tools, sortOrder, href: project.url }];
  })
  .sort((a, b) => a.sortOrder - b.sortOrder || a.title.localeCompare(b.title, "en"));
---

<BaseLayout title="Projects" description="Explore Ben Buechler’s projects, from first ideas to design decisions and results.">
  <header class="page-heading">
    <p class="eyebrow">Projects</p>
    <h1>Ideas put into practice<span class="accent">.</span></h1>
    <p class="page-intro">
      A collection of what I’m building. Explore a project for the idea behind it,
      how it works, and what I’ve learned along the way.
    </p>
  </header>

  <section aria-labelledby="project-list-heading" class="page-section">
    <h2 id="project-list-heading">My projects</h2>
    {projects.length > 0 ? (
      <ul class="project-grid" role="list">
        {projects.map((project, index) => (
          <li>
            <article class="project-card">
              {/* One native link makes the whole card work with touch, mouse,
                  and keyboard. The title names it without reading every tag. */}
              <a class="project-link" href={project.href} aria-labelledby={`project-title-${index}`} aria-describedby={`project-summary-${index}`}>
                <img
                  class="project-image"
                  src={`${basePath}${project.image}`}
                  alt={project.imageAlt}
                  width="960"
                  height="600"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
                <div class="project-content">
                  <h3 id={`project-title-${index}`}>{project.title}</h3>
                  <p class="project-summary" id={`project-summary-${index}`}>{project.summary}</p>
                  {project.tools.length > 0 && (
                    <ul class="tag-list" aria-label="Tools and technologies">
                      {project.tools.map((tool) => <li>{tool}</li>)}
                    </ul>
                  )}
                  <span class="project-action">Explore project <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <div class="content-card empty-state">
        <h3>Project write-ups are on the way.</h3>
        <p>Check back for project overviews, design decisions, and results.</p>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .accent {
    color: var(--color-accent);
  }

  /* Fixed column counts keep the first card the same size as future entries. */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .project-grid > li {
    min-width: 0;
  }

  .project-card {
    height: 100%;
  }

  .project-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-surface);
    overflow-wrap: anywhere;
  }

  /* Reserve picture space before loading, and crop all covers consistently. */
  .project-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    border-radius: calc(var(--border-radius) - 1px) calc(var(--border-radius) - 1px) 0 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .project-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }

  h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .project-summary {
    margin: 0.875rem 0 1.25rem;
    color: var(--color-muted);
  }

  .tag-list {
    margin: 0 0 1.5rem;
  }

  /* Push the action to the bottom so cards in a row have aligned links. */
  .project-action {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .project-link:hover,
  .project-link:focus-visible {
    border-color: var(--color-accent);
  }

  .project-link:hover .project-action,
  .project-link:focus-visible .project-action {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  @media (max-width: 1100px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
