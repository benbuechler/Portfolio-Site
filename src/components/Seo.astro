---
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/images/social-card.png",
  imageAlt = "Ben Buechler — Electrical Engineering Portfolio",
  noindex = false,
} = Astro.props;

if (!Astro.site) throw new Error("Set site in astro.config.mjs before building SEO metadata.");
const site = Astro.site;
// Build from the configured domain, never a preview host or tracking query.
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(pathname, site).href;
const pageTitle = `${title} | Ben Buechler`;
const imageURL = new URL(image, site).href;
const personId = new URL("#person", site).href;
const websiteId = new URL("#website", site).href;
const hub = pathname.startsWith("/projects/") ? "projects"
  : pathname.startsWith("/experience/") ? "experience" : undefined;
const breadcrumbs = [
  { name: "Home", item: site.href },
  ...(hub ? [{ name: hub === "projects" ? "Projects" : "Experience", item: new URL(`/${hub}`, site).href }] : []),
  { name: title, item: canonical },
];
const pageType = pathname === "/" ? "ProfilePage"
  : pathname === "/contact" ? "ContactPage"
  : ["/projects", "/experience"].includes(pathname) ? "CollectionPage" : "WebPage";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Ben Buechler",
      alternateName: "Benjamin Buechler",
      url: site.href,
      jobTitle: "Electrical Engineering Technology Student",
      description: "Electrical engineering student with a passion for technology and innovation.",
      sameAs: [
        "https://www.linkedin.com/in/ben-buechler/",
        "https://github.com/benbuechler",
        "https://www.youtube.com/@realbengineering",
      ],
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: site.href,
      name: "Ben Buechler",
      alternateName: "Ben Buechler’s Engineering Portfolio",
      publisher: { "@id": personId },
      inLanguage: "en-CA",
    },
    {
      "@type": pageType,
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description,
      isPartOf: { "@id": websiteId },
      about: { "@id": personId },
      ...(pathname === "/" ? { mainEntity: { "@id": personId } } : {}),
      ...(pathname !== "/" ? { breadcrumb: { "@id": `${canonical}#breadcrumb` } } : {}),
      inLanguage: "en-CA",
    },
    ...(pathname === "/" ? [] : [{
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        ...crumb,
      })),
    }]),
  ],
};
// Escape '<' so future page text cannot terminate the JSON script element.
const jsonLD = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="Ben Buechler" />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Ben Buechler" />
<meta property="og:locale" content="en_CA" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />
{image === "/images/social-card.png" && <>
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
</>}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />
{!noindex && <script type="application/ld+json" is:inline set:html={jsonLD} />}
