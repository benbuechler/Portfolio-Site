---
// Astro frontmatter runs while rendering HTML (at build time for this static
// site), rather than in the visitor's browser. Imports reuse code from other files.
import { createPageCloud } from "../lib/page-cloud";
// `import type` is used by TypeScript checking and produces no runtime code.
import type { SitePage } from "../lib/site-pages";

// Props describes the inputs a parent passes to <PageCloud>. `SitePage[]` means
// an array of objects that each follow the shared SitePage type.
interface Props {
  pages: SitePage[];
}

// Object destructuring pulls named properties into local variables. The parent
// supplies pages, and createPageCloud prepares the initial navigation link data.
const { pages } = Astro.props;
const { nodes } = createPageCloud(pages);
---

<!--
  This custom element becomes interactive when its class is registered below.
  data-* attributes store our own data on HTML elements. JSON.stringify converts
  the array into text; Astro safely writes it into this attribute, and the browser
  reads it back through dataset.pages. role and aria-label give this region an
  accessible name for people using assistive technology.
-->
<page-cloud data-pages={JSON.stringify(pages)} role="region" aria-label="Explore the portfolio">
  <div class="cloud-heading">
    <span>Explore the site</span>
    <!-- hidden keeps a control unavailable until its script is ready.
         type="button" prevents accidental submission inside a surrounding form. -->
    <button class="cloud-reset" type="button" hidden>
      <!-- SVG draws the reset icon with a path. viewBox defines its coordinates;
           currentColor follows the button's CSS text color. The adjacent words
           already name the button, so aria-hidden hides this decorative icon. -->
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 11a9 9 0 1 1 2.6 7M3 4v7h7" />
      </svg>
      Reset view
    </button>
  </div>
  <!-- aria-describedby connects the map to the instructions with that id. -->
  <div class="cloud-viewport" role="group" aria-label="Rotate the 3D site map" aria-describedby="cloud-instructions">
    <!-- Canvas is a bitmap drawing surface for dots and lines. The links stay
         ordinary HTML so they retain names, destinations, and keyboard access. -->
    <canvas aria-hidden="true"></canvas>
    <nav class="cloud-links" aria-label="Site map pages">
      <!-- Keep one label per node so drawing indexes stay aligned. Entries
           without stories use plain text, with no destination or Tab stop. -->
      {nodes.map((node, index) => {
        const hasStory = pages[index].hasStory !== false;
        const Label = hasStory ? "a" : "span";
        return (
          <Label
            class:list={["cloud-label", { "cloud-link": hasStory }]}
            href={hasStory ? node.href : undefined}
            data-node={index}
            aria-label={hasStory ? pages[index].label : undefined}
            draggable="false"
          >
            {node.label}
          </Label>
        );
      })}
    </nav>
  </div>
  <!-- CSS switches between desktop/touch hints. sr-only supplies extra details
       to screen readers; the arrow buttons each have an explicit accessible name. -->
  <div class="cloud-controls" hidden>
    <p class="cloud-help" id="cloud-instructions">
      <span class="desktop-help">Drag to rotate · Select a page</span>
      <span class="touch-help">Swipe to spin · Tap a page</span>
      <span class="sr-only">Focus the map and use the arrow keys to rotate, or use the rotation buttons. Press Home to reset the view. Tab to a page link and press Enter to visit it.</span>
    </p>
    <div class="rotation-buttons" role="group" aria-label="Rotate map">
      <button type="button" data-rotate="left" aria-label="Rotate map left">←</button>
      <button type="button" data-rotate="up" aria-label="Tilt map up">↑</button>
      <button type="button" data-rotate="down" aria-label="Tilt map down">↓</button>
      <button type="button" data-rotate="right" aria-label="Rotate map right">→</button>
      <button class="cloud-motion" type="button" aria-label="Pause automatic rotation" title="Pause automatic rotation">
        <svg class="motion-pause" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
          <path d="M8 5v14M16 5v14" />
        </svg>
        <svg class="motion-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="m8 5 11 7-11 7Z" />
        </svg>
      </button>
    </div>
  </div>
</page-cloud>

<!-- This script runs in the browser. Astro converts its TypeScript to JavaScript
     and bundles the imports, unlike the build-time frontmatter above. -->
<script>
  import { createPageCloud, layoutPageCloud, DEFAULT_CLOUD_ROTATION } from "../lib/page-cloud";
  import type { SitePage } from "../lib/site-pages";

  // `extends` inherits standard HTML element behavior. The custom element keeps
  // this map's setup and teardown alongside the <page-cloud> that owns them.
  class PageCloud extends HTMLElement {
    // TypeScript's private marks an internal class member. `?` allows undefined;
    // `() => void` describes a function with no arguments or return value.
    private cleanup?: () => void;

    // The browser calls this lifecycle method when the element joins the page.
    // `this` refers to this <page-cloud>; the guard avoids installing handlers twice.
    connectedCallback() {
      if (this.cleanup) return;
      // Query this element's descendants. The <HTMLElement> generic tells
      // TypeScript which kind of result we expect, without changing the DOM.
      const viewport = this.querySelector<HTMLElement>(".cloud-viewport");
      const canvas = this.querySelector("canvas");
      // Optional chaining (?.) calls getContext only if canvas exists. A 2D
      // context exposes commands for drawing shapes onto the bitmap.
      const context = canvas?.getContext("2d");
      // `!` means "not" and `||` means "or". Stop if any required piece is absent;
      // the HTML navigation links will still work without the interactive diagram.
      if (!viewport || !canvas || !context) return;

      // The annotation describes an array of href/label objects. JSON.parse turns
      // saved text back into data. `??` supplies "[]" only for null/undefined;
      // TypeScript's annotation does not validate the JSON at runtime.
      const pages: SitePage[] = JSON.parse(this.dataset.pages ?? "[]");
      // nodes are 3D points; connections contain pairs of their indexes; extent
      // describes the original scale. The helper keeps geometry separate from UI.
      const { nodes, connections, extent } = createPageCloud(pages);
      // querySelectorAll returns a NodeList. `...` spreads its entries into an
      // ordinary array so we can use array methods such as map below.
      const labels = [...this.querySelectorAll<HTMLElement>(".cloud-label")];
      // Every listener using this signal can be removed together with abort().
      const controller = new AbortController();
      const options = { signal: controller.signal };
      // `const` prevents reassignment; `let` allows a variable's value to change.
      // These variables hold measured dimensions, colors, and interaction state.
      let width = 0;
      let height = 0;
      let accent = "";
      let surface = "";
      // Object spread makes a copy, leaving the imported default object unchanged.
      let rotation = { ...DEFAULT_CLOUD_ROTATION };
      // ReturnType derives the result type of layoutPageCloud; typeof refers to
      // its function type here, so we do not repeat the projected-point definition.
      let positions: ReturnType<typeof layoutPageCloud> = [];
      let sizes = labels.map(() => ({ width: 0, height: 0 }));
      // Array indexes start at 0; -1 represents "no hovered/focused node".
      let hovered = -1;
      let focused = -1;
      // frame stores a queued animation request; 0 means no request is pending.
      let frame = 0;
      let disposed = false;
      let suppressClick = false;
      // `| undefined` allows either a drag record or no drag. yaw rotates sideways
      // and pitch tilts vertically, both in radians rather than degrees.
      let drag: { id: number; x: number; y: number; yaw: number; pitch: number; moved: boolean } | undefined;

      const cloud = this;
      const motionButton = this.querySelector<HTMLButtonElement>(".cloud-motion");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      // An explicit button choice overrides the default motion preference.
      let motionChoice: boolean | undefined;
      const wantsMotion = () => motionChoice ?? !reducedMotion.matches;
      let inView = typeof IntersectionObserver === "undefined";
      let previousDriftTime: number | undefined;
      let resumeAfter = 0;
      let resumeTimer: ReturnType<typeof setTimeout> | undefined;
      const driftSpeed = 0.06; // Maximum radians per second for the gentle drift.
      let directionRemaining = 0;
      let yawVelocity = 0;
      let pitchVelocity = 0;
      let targetYawVelocity = 0;
      let targetPitchVelocity = 0;

      // Three faint great circles make the volume visible as the map turns.
      // map creates one ring per axis. Array.from makes 65 sample points; `_`
      // marks an unused value. index / 64 covers one full turn (2 * PI radians).
      // sin/cos convert each angle into coordinates on its circle.
      const orbits = [0, 1, 2].map((axis) => Array.from({ length: 65 }, (_, index) => {
        const angle = index / 64 * Math.PI * 2;
        const a = Math.cos(angle);
        const b = Math.sin(angle);
        // `condition ? yes : no` is a ternary expression. These choices put each
        // ring in a different plane. Empty link fields let it use the same helper.
        return { href: "", label: "", x: axis === 0 ? 0 : a, y: axis === 1 ? 0 : axis === 0 ? a : b, z: axis === 2 ? 0 : b };
      }));

      // Canvas does not retain editable shape objects. Repainting clears the old
      // pixels, projects the current 3D positions, and draws everything again.
      function draw() {
        if (!width || !height) return;
        // The non-null assertion `!` tells TypeScript the earlier setup guard
        // checked context. It does not add a runtime check or change the value.
        const ctx = context!;
        ctx.clearRect(0, 0, width, height);
        // Project 3D coordinates onto the 2D drawing surface at the current angle.
        positions = layoutPageCloud(nodes, extent, width, height, rotation);
        // Prefer the hovered node; otherwise highlight the keyboard-focused one.
        const active = hovered >= 0 ? hovered : focused;
        // Drawing settings persist. Alpha is opacity (0 invisible, 1 solid).
        // A dash pattern of [3, 6] alternates 3px lines and 6px gaps.
        ctx.strokeStyle = accent;
        ctx.lineWidth = 1;
        ctx.globalAlpha = 0.12;
        ctx.setLineDash([3, 6]);
        // for...of visits each ring. beginPath starts a shape, moveTo places its
        // first point, lineTo adds connected segments, and stroke paints the line.
        for (const orbit of orbits) {
          const ring = layoutPageCloud(orbit, 1, width, height, rotation);
          ctx.beginPath();
          ring.forEach((point, index) => index ? ctx.lineTo(point.x, point.y) : ctx.moveTo(point.x, point.y));
          ctx.stroke();
        }
        // Restore solid lines before drawing connections between nodes.
        ctx.setLineDash([]);

        // Array destructuring names the two endpoint indexes. Connections touching
        // the active node become brighter and thicker for visual feedback.
        for (const [from, to] of connections) {
          const highlighted = from === active || to === active;
          ctx.globalAlpha = highlighted ? 0.85 : 0.3;
          ctx.lineWidth = highlighted ? 1.8 : 1;
          ctx.beginPath();
          ctx.moveTo(positions[from].x, positions[from].y);
          ctx.lineTo(positions[to].x, positions[to].y);
          ctx.stroke();
        }

        // Move every label beside its dot, including nodes without story links.
        positions.forEach((point, index) => {
          const selected = index === active;
          const size = sizes[index];
          // Keep a fixed offset from each node instead of repacking labels as
          // the map turns. Clamping at the edges is continuous, so nothing jumps.
          const offset = index === 0 ? -size.width - 12 : 12;
          // Math.min/Math.max clamp each label to the viewport with an 8px margin.
          const x = Math.max(8, Math.min(width - size.width - 8, point.x + offset));
          const y = Math.max(8, Math.min(height - size.height - 8, point.y - size.height / 2));
          // Backticks create a template string; ${...} inserts values into it.
          // translate moves the label visually without rearranging sibling links.
          labels[index].style.transform = `translate(${x}px, ${y}px)`;
          // Raise the active label above others; data-active lets CSS use the
          // same highlight for a hovered dot, hovered label, or focused link.
          labels[index].style.zIndex = selected ? "2" : "1";
          labels[index].toggleAttribute("data-active", selected);
        });

        // Draw the nearest nodes last; perspective also changes their size.
        // map copies each point and adds its original index; sort then orders
        // this new array by depth. Subtracting z values gives a numeric comparison.
        positions.map((point, index) => ({ ...point, index })).sort((a, b) => a.z - b.z).forEach((point) => {
          const selected = point.index === active;
          const radius = (point.index === 0 ? 6 : 4.5) * point.perspective;
          // Paint a soft halo, a background-colored rim, then the dot. arc uses
          // radians, so 0 through 2 * PI creates a full circle; fill colors it in.
          ctx.globalAlpha = selected ? 0.25 : 0.1;
          ctx.fillStyle = accent;
          ctx.beginPath();
          ctx.arc(point.x, point.y, radius + (selected ? 12 : 6), 0, Math.PI * 2);
          ctx.fill();
          ctx.globalAlpha = 1;
          ctx.fillStyle = surface;
          ctx.beginPath();
          ctx.arc(point.x, point.y, radius + 2, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = accent;
          ctx.globalAlpha = selected ? 1 : 0.65 + (point.z + 1) * 0.15;
          ctx.beginPath();
          ctx.arc(point.x, point.y, radius, 0, Math.PI * 2);
          ctx.fill();
        });
        ctx.globalAlpha = 1;
      }

      // Manual updates and idle rotation share one frame. Use elapsed time so
      // drift has the same speed on displays with different refresh rates.
      function requestDraw() {
        if (frame || disposed) return;
        frame = requestAnimationFrame((now) => {
          frame = 0;
          const active = document.activeElement;
          const keyboardFocus = active instanceof Element && cloud.contains(active) && active.matches(":focus-visible");
          const drifting = wantsMotion() && inView && !document.hidden && !keyboardFocus && !drag
            && width > 0 && height > 0 && nodes.length > 1 && now >= resumeAfter;
          if (drifting) {
            if (previousDriftTime !== undefined) {
              // Cap long frames so resuming after a delay never jumps the view.
              const seconds = Math.min(now - previousDriftTime, 64) / 1000;
              directionRemaining -= seconds;
              if (directionRemaining <= 0) {
                const direction = Math.random() * Math.PI * 2;
                const speed = driftSpeed * (0.55 + Math.random() * 0.45);
                targetYawVelocity = Math.cos(direction) * speed;
                targetPitchVelocity = Math.sin(direction) * speed * 0.35;
                directionRemaining = 4 + Math.random() * 5;
              }
              // Ease toward each random direction instead of switching abruptly.
              // Near the tilt limits, gently steer back toward the middle.
              if (rotation.pitch > 1.1) targetPitchVelocity = -Math.abs(targetPitchVelocity);
              if (rotation.pitch < -1.1) targetPitchVelocity = Math.abs(targetPitchVelocity);
              const blend = 1 - Math.exp(-seconds * 0.7);
              yawVelocity += (targetYawVelocity - yawVelocity) * blend;
              pitchVelocity += (targetPitchVelocity - pitchVelocity) * blend;
              rotation.yaw = (rotation.yaw + seconds * yawVelocity) % (Math.PI * 2);
              rotation.pitch = Math.max(-1.45, Math.min(1.45, rotation.pitch + seconds * pitchVelocity));
            }
            previousDriftTime = now;
          } else {
            previousDriftTime = undefined;
          }
          draw();
          if (drifting) requestDraw();
        });
      }

      // Wait briefly after interaction. A timer wakes the renderer once the
      // delay ends, rather than repainting continuously while it is paused.
      function holdDrift() {
        previousDriftTime = undefined;
        resumeAfter = performance.now() + 1800;
        clearTimeout(resumeTimer);
        // Keep a wake-up even if motion is currently disabled: the preference
        // may change before this cooldown ends.
        resumeTimer = setTimeout(() => { resumeTimer = undefined; requestDraw(); }, 1800);
        requestDraw();
      }

      // `%` is the remainder operator: wrap yaw around a full turn. Clamp pitch
      // just short of straight up/down so the view cannot flip over vertically.
      function setRotation(yaw: number, pitch: number) {
        rotation = { yaw: yaw % (Math.PI * 2), pitch: Math.max(-1.45, Math.min(1.45, pitch)) };
        yawVelocity = 0;
        pitchVelocity = 0;
        directionRemaining = 0;
        holdDrift();
      }

      // Copy the starting rotation and redraw without reloading the page.
      function reset() {
        setRotation(DEFAULT_CLOUD_ROTATION.yaw, DEFAULT_CLOUD_ROTATION.pitch);
      }

      // Identify both linked and static labels. Static labels must also stop
      // clicks from falling through to a nearby dot's navigation handler.
      function nodeFromTarget(target: EventTarget | null) {
        const label = target instanceof Element ? target.closest<HTMLElement>(".cloud-label") : null;
        return label ? Number(label.dataset.node) : -1;
      }

      function canNavigate(index: number) {
        return index >= 0 && pages[index]?.hasStory !== false;
      }

      // Canvas dots are pixels, not separate DOM elements. Hit testing chooses
      // the nearest projected node within 20 pixels of the pointer.
      function hitNode(clientX: number, clientY: number) {
        const bounds = viewport!.getBoundingClientRect();
        let hit = -1;
        let distance = 20;
        positions.forEach((point, index) => {
          // clientX/Y use browser-window coordinates. Subtract the viewport's
          // offset to match canvas coordinates; hypot gives the distance.
          const next = Math.hypot(clientX - bounds.left - point.x, clientY - bounds.top - point.y);
          if (next < distance) { hit = index; distance = next; }
        });
        return hit;
      }

      // Pointer events cover mouse, touch, and pen. Only the primary pointer's
      // main button can start a drag. Save its start position and rotation so all
      // later movement is measured from a stable reference.
      viewport.addEventListener("pointerdown", (event) => {
        if (!event.isPrimary || event.button !== 0 || drag) return;
        suppressClick = false;
        drag = { id: event.pointerId, x: event.clientX, y: event.clientY, ...rotation, moved: false };
      }, options);
      // Optional chaining checks the drag id only when a drag exists. Require
      // movement beyond 7px to distinguish an intentional drag from a click/tap.
      viewport.addEventListener("pointermove", (event) => {
        if (drag?.id === event.pointerId) {
          const dx = event.clientX - drag.x;
          const dy = event.clientY - drag.y;
          if (!drag.moved && Math.hypot(dx, dy) > 7) {
            drag.moved = true;
            // Capture keeps this pointer's events arriving outside the viewport.
            // The data attribute also selects the dragging cursor through CSS.
            viewport.setPointerCapture(event.pointerId);
            viewport.dataset.dragging = "true";
            hovered = -1;
          }
          if (drag.moved) {
            // Cancel the browser's default action when allowed. Scaling pixel
            // movement by 0.008 controls how fast the map rotates.
            if (event.cancelable) event.preventDefault();
            setRotation(drag.yaw + dx * 0.008, drag.pitch + dy * 0.008);
          }
        } else if (!drag) {
          // When idle, either a real link or a nearby drawn dot can be highlighted.
          const targetNode = nodeFromTarget(event.target);
          const candidate = targetNode >= 0 ? targetNode : hitNode(event.clientX, event.clientY);
          const next = canNavigate(candidate) ? candidate : -1;
          if (hovered !== next) { hovered = next; requestDraw(); }
          viewport.dataset.overNode = String(next >= 0);
        }
      }, options);

      // Share this arrow-function handler across normal and canceled drag endings.
      // PointerEvent tells TypeScript which event properties should be available.
      const endDrag = (event: PointerEvent) => {
        if (drag?.id !== event.pointerId) return;
        if (event.type === "pointerup" && drag.moved) {
          // A drag starting on a link must never become an accidental page visit.
          suppressClick = true;
        }
        drag = undefined;
        // delete removes the data attribute; release capture if it was acquired.
        delete viewport.dataset.dragging;
        if (viewport.hasPointerCapture(event.pointerId)) viewport.releasePointerCapture(event.pointerId);
        holdDrift();
      };
      viewport.addEventListener("pointerup", endDrag, options);
      viewport.addEventListener("pointercancel", endDrag, options);
      viewport.addEventListener("lostpointercapture", endDrag, options);
      // Release a mouse press that leaves the viewport before becoming a drag.
      window.addEventListener("pointerup", endDrag, options);
      // Capture runs before normal link click handling. After a drag, cancel its
      // pointer-generated click (detail > 0), while preserving keyboard clicks.
      // stopPropagation also prevents other handlers from seeing the canceled click.
      viewport.addEventListener("click", (event) => {
        if (suppressClick && event.detail > 0) {
          event.preventDefault();
          event.stopPropagation();
          suppressClick = false;
          return;
        }
        // A real link already navigates normally. A click on a dot instead sends
        // a click to its matching link, keeping modifier keys such as Ctrl/Command
        // that visitors use to open a destination in another tab.
        if (nodeFromTarget(event.target) >= 0) return;
        const hit = hitNode(event.clientX, event.clientY);
        if (canNavigate(hit)) {
          labels[hit].dispatchEvent(new MouseEvent("click", {
            bubbles: true, cancelable: true, view: window,
            ctrlKey: event.ctrlKey, metaKey: event.metaKey, shiftKey: event.shiftKey, altKey: event.altKey,
          }));
        }
      // Object spread retains the shared abort signal while adding capture here.
      }, { ...options, capture: true });
      // Clear transient hover on exit. Focus events bubble, so the viewport's
      // handlers can track keyboard focus moving through any of its links.
      viewport.addEventListener("pointerleave", () => {
        hovered = -1;
        delete viewport.dataset.overNode;
        requestDraw();
      }, options);
      viewport.addEventListener("focusin", (event) => { focused = nodeFromTarget(event.target); requestDraw(); }, options);
      viewport.addEventListener("focusout", () => { focused = -1; requestDraw(); }, options);

      // Pause for actual presses and keyboard interaction. Hovering can still
      // highlight nodes while the map drifts; mouse/touch focus resumes later.
      this.addEventListener("pointerdown", holdDrift, options);
      this.addEventListener("focusin", holdDrift, options);
      this.addEventListener("focusout", holdDrift, options);

      const updateMotionButton = () => {
        if (!motionButton) return;
        const action = wantsMotion() ? "Pause automatic rotation" : "Resume automatic rotation";
        motionButton.dataset.paused = String(!wantsMotion());
        motionButton.setAttribute("aria-label", action);
        motionButton.title = action;
      };
      motionButton?.addEventListener("click", () => {
        motionChoice = !wantsMotion();
        updateMotionButton();
        holdDrift();
      }, options);
      reducedMotion.addEventListener("change", () => {
        // A newly enabled reduced-motion setting stops an existing drift.
        if (reducedMotion.matches && motionChoice === true) motionChoice = undefined;
        previousDriftTime = undefined;
        updateMotionButton();
        requestDraw();
      }, options);
      document.addEventListener("visibilitychange", () => {
        previousDriftTime = undefined;
        requestDraw();
      }, options);
      // Rotate only while the viewport itself has focus, preserving normal keys
      // for focused links. Holding Shift chooses a larger rotation step.
      viewport.addEventListener("keydown", (event) => {
        if (event.target !== viewport) return;
        const step = event.shiftKey ? 0.3 : 0.12;
        // switch selects a matching key; break ends a case. Unknown keys return
        // early, so we only prevent browser actions for the keys handled here.
        switch (event.key) {
          case "ArrowLeft": setRotation(rotation.yaw - step, rotation.pitch); break;
          case "ArrowRight": setRotation(rotation.yaw + step, rotation.pitch); break;
          case "ArrowUp": setRotation(rotation.yaw, rotation.pitch - step); break;
          case "ArrowDown": setRotation(rotation.yaw, rotation.pitch + step); break;
          case "Home": reset(); break;
          default: return;
        }
        event.preventDefault();
      }, options);
      // Optional chaining permits a missing reset button. data-rotate selects
      // the horizontal or vertical change associated with each arrow button.
      this.querySelector(".cloud-reset")?.addEventListener("click", reset, options);
      this.querySelectorAll<HTMLButtonElement>("[data-rotate]").forEach((button) => {
        button.addEventListener("click", () => {
          const direction = button.dataset.rotate;
          setRotation(rotation.yaw + (direction === "left" ? -0.25 : direction === "right" ? 0.25 : 0),
            rotation.pitch + (direction === "up" ? -0.2 : direction === "down" ? 0.2 : 0));
        }, options);
      });

      // Measure viewport and label sizes again whenever either changes. Layout
      // uses CSS pixels; high-DPI screens need extra backing pixels for sharp lines.
      const resize = () => {
        const bounds = viewport.getBoundingClientRect();
        width = bounds.width;
        height = bounds.height;
        // Cap density at 2 to limit rendering cost. `|| 1` falls back when density
        // is falsy. Canvas dimensions must be integers, hence Math.round below.
        const ratio = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        // Canvas width/height assignments reset its drawing state. Scale the
        // context afterward so our geometry can keep using ordinary CSS pixels.
        context.setTransform(ratio, 0, 0, ratio, 0, 0);
        sizes = labels.map((label) => {
          const bounds = label.getBoundingClientRect();
          return { width: bounds.width, height: bounds.height };
        });
        draw();
      };
      // CSS changes do not repaint canvas pixels automatically. Read this
      // element's resolved CSS custom properties, then request a new drawing.
      const readTheme = () => {
        const styles = getComputedStyle(this);
        accent = styles.getPropertyValue("--color-accent").trim();
        surface = styles.getPropertyValue("--color-bg").trim();
        requestDraw();
      };

      // Progressive enhancement: after setup succeeds, activate diagram CSS,
      // make the viewport keyboard-focusable, and reveal its interaction controls.
      this.dataset.ready = "true";
      viewport.tabIndex = 0;
      this.querySelectorAll<HTMLElement>("[hidden]").forEach((element) => { element.hidden = false; });
      readTheme();
      resize();
      // Observe actual element sizes, including labels that can change when a
      // font loads. A separate observer watches the root theme attribute.
      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(viewport);
      labels.forEach((label) => resizeObserver.observe(label));
      const themeObserver = new MutationObserver(readTheme);
      // documentElement is <html>. Watch only data-theme, which the shared
